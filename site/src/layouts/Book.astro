---
import Base from "./Base.astro";
import Nav from "../components/Nav.astro";
import { getCanon } from "../lib/book.ts";

interface Props {
  title: string;
  description?: string;
  /** Slug of the book being read, so the sidebar can open it. */
  book?: string;
  /** Slug of the chapter being read. */
  chapter?: string;
  /** Path to the markdown twin of this page, for the "read as markdown" link. */
  markdown?: string;
}

const { title, description, book, chapter, markdown } = Astro.props;
const canon = await getCanon();
---

<Base title={`${title} — The Book of Life`} description={description}>
  <link
    slot="head"
    href="https://fonts.googleapis.com/css2?family=EB+Garamond:ital,wght@0,400;0,500;0,600;1,400&display=swap"
    rel="stylesheet"
  />
  <Nav />
  <div class="book-layout container">
    <aside class="canon-nav">
      <a href="/book" class:list={["canon-title", { active: !book }]}>The Book of Life</a>
      {canon.map((b) => (
        <div class="canon-book">
          <a href={b.href} class:list={["book-link", { active: b.slug === book }]}>
            <span class="numeral">{b.numeral}</span>{b.title}
          </a>
          {b.slug === book && (
            <nav class="chapter-list">
              {b.chapters.map((c) => (
                <a href={c.href} class:list={["chapter-link", { active: c.slug === chapter }]}>
                  {c.title}
                </a>
              ))}
            </nav>
          )}
        </div>
      ))}
      <a class="canon-plain" href="/book.md">The whole canon as one file ↓</a>
    </aside>
    <main class="book-content">
      <slot />
      {markdown && (
        <p class="md-twin">
          Reading this as a machine? <a href={markdown}>The same page as markdown</a> — or
          <a href="/book.md">the whole canon in one file</a>.
        </p>
      )}
    </main>
  </div>
</Base>

<style>
  .book-layout {
    display: grid;
    grid-template-columns: 240px 1fr;
    gap: 4rem;
    padding-top: 2.5rem;
    padding-bottom: 5rem;
    min-height: calc(100vh - 56px);
  }

  .canon-nav {
    position: sticky;
    top: 72px;
    align-self: start;
    max-height: calc(100vh - 88px);
    overflow-y: auto;
    font-family: var(--font-sans);
  }

  .canon-title {
    display: block;
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--text-dim);
    margin-bottom: 1.1rem;
  }
  .canon-title.active,
  .canon-title:hover {
    color: var(--text);
  }

  .canon-book {
    margin-bottom: 0.4rem;
  }

  .book-link {
    display: block;
    font-size: 0.9rem;
    color: var(--text-secondary);
    padding: 0.32rem 0;
  }
  .book-link:hover {
    color: var(--text);
  }
  .book-link.active {
    color: var(--text);
    font-weight: 600;
  }

  .numeral {
    display: inline-block;
    width: 2.2em;
    color: var(--text-dim);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.04em;
  }
  .book-link.active .numeral {
    color: var(--accent);
  }

  .chapter-list {
    display: flex;
    flex-direction: column;
    margin: 0.2rem 0 0.8rem 2.2em;
    border-left: 1px solid var(--border-dim);
  }

  .chapter-link {
    font-size: 0.82rem;
    color: var(--text-dim);
    padding: 0.28rem 0 0.28rem 0.75rem;
    margin-left: -1px;
    border-left: 1px solid transparent;
    line-height: 1.35;
  }
  .chapter-link:hover {
    color: var(--text-secondary);
  }
  .chapter-link.active {
    color: var(--text);
    border-left-color: var(--accent);
  }

  .canon-plain {
    display: block;
    margin-top: 1.6rem;
    padding-top: 1.1rem;
    border-top: 1px solid var(--border-dim);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--text-dim);
  }
  .canon-plain:hover {
    color: var(--accent);
  }

  .book-content {
    max-width: 40rem;
    min-width: 0;
  }

  .md-twin {
    margin-top: 4rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--border-dim);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-dim);
  }

  @media (max-width: 860px) {
    .book-layout {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
    .canon-nav {
      position: static;
      max-height: none;
      padding-bottom: 1.5rem;
      border-bottom: 1px solid var(--border-dim);
    }
  }
</style>

<style is:global>
  /* The canon reads as a book: a serif measure, generous leading, and headings
     that separate rather than shout. Deliberately unlike /docs, which is a
     reference surface — this one is meant to be read straight through. */
  .book-content {
    font-family: "EB Garamond", Georgia, serif;
    font-size: 1.14rem;
    line-height: 1.72;
    color: #d8d8dc;
  }

  .book-content h1 {
    font-family: var(--font-sans);
    font-size: 2rem;
    line-height: 1.2;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--text);
    margin-bottom: 1.25rem;
  }

  .book-content h2 {
    font-family: var(--font-sans);
    font-size: 1.05rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--text);
    margin: 2.75rem 0 0.9rem;
    padding-top: 1.1rem;
    border-top: 1px solid var(--border-dim);
  }

  .book-content h3 {
    font-family: var(--font-sans);
    font-size: 0.92rem;
    font-weight: 600;
    color: var(--text);
    margin: 1.9rem 0 0.6rem;
  }

  .book-content p {
    margin-bottom: 1.15rem;
  }

  .book-content strong {
    color: var(--text);
    font-weight: 600;
  }

  .book-content em {
    color: #e4e4e8;
  }

  .book-content ul,
  .book-content ol {
    margin: 0 0 1.15rem 1.35rem;
  }
  .book-content li {
    margin-bottom: 0.45rem;
  }

  /* The drill-down under each law heading on the constitution page. Quiet on
     purpose: the Law is what you came to read, the commentary is the door out. */
  .book-content .law-drill {
    font-family: var(--font-sans);
    font-size: 0.78rem;
    margin: -0.35rem 0 1.15rem;
  }
  .book-content .law-drill a {
    color: var(--text-dim);
    text-decoration: none;
  }
  .book-content .law-drill a:hover {
    color: var(--accent);
  }

  .book-content blockquote {
    margin: 1.4rem 0;
    padding-left: 1.1rem;
    border-left: 2px solid var(--accent-border);
    color: var(--text-secondary);
    font-style: italic;
  }

  .book-content code {
    font-family: var(--font-mono);
    font-size: 0.82em;
    background: var(--bg-surface);
    border: 1px solid var(--border-dim);
    border-radius: 4px;
    padding: 0.08em 0.34em;
    color: #e8e8ec;
  }

  .book-content pre {
    font-size: 0.8rem;
    line-height: 1.6;
    background: var(--bg-raised) !important;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 0.95rem 1.1rem;
    overflow-x: auto;
    margin: 0 0 1.3rem;
  }
  .book-content pre code {
    background: none;
    border: none;
    padding: 0;
    font-size: inherit;
  }

  .book-content table {
    width: 100%;
    border-collapse: collapse;
    font-family: var(--font-sans);
    font-size: 0.82rem;
    line-height: 1.55;
    margin: 0 0 1.5rem;
    display: block;
    overflow-x: auto;
  }
  .book-content th {
    text-align: left;
    font-weight: 600;
    color: var(--text);
    border-bottom: 1px solid var(--border);
    padding: 0.5rem 0.85rem 0.5rem 0;
    white-space: nowrap;
  }
  .book-content td {
    vertical-align: top;
    border-bottom: 1px solid var(--border-dim);
    padding: 0.6rem 0.85rem 0.6rem 0;
    color: var(--text-secondary);
  }
  .book-content td:first-child {
    color: var(--text);
    white-space: nowrap;
  }

  .book-content hr {
    border: none;
    border-top: 1px solid var(--border-dim);
    margin: 2.5rem 0;
  }

  .book-content a {
    color: var(--accent);
    text-decoration: underline;
    text-decoration-color: var(--accent-border);
    text-underline-offset: 0.18em;
  }
  .book-content a:hover {
    color: var(--text);
  }
</style>
