---
import { render } from "astro:content";
import BookLayout from "../../../layouts/Book.astro";
import { getCanon, getReadingOrder, openingNote } from "../../../lib/book.ts";

export async function getStaticPaths() {
  const canon = await getCanon();
  const order = await getReadingOrder();
  return canon.flatMap((book) =>
    book.chapters.map((chapter) => {
      const i = order.findIndex((o) => o.book.slug === book.slug && o.chapter.slug === chapter.slug);
      return {
        params: { book: book.slug, chapter: chapter.slug },
        props: { book, chapter, prev: order[i - 1] ?? null, next: order[i + 1] ?? null },
      };
    }),
  );
}

const { book, chapter, prev, next } = Astro.props;
const { Content } = await render(chapter.entry);
const note = openingNote(book.slug, chapter.slug);
---

<BookLayout
  title={chapter.title}
  description={`${chapter.title} — Book ${book.numeral}, ${book.title}, of the Book of Life.`}
  book={book.slug}
  chapter={chapter.slug}
  markdown={`/book/${book.slug}/${chapter.slug}.md`}
>
  <p class="book-mark">
    Book {book.numeral} · <a href={book.href}>{book.title}</a>
  </p>
  {note && <aside class="opening-note">{note}</aside>}
  <Content />

  <nav class="turn">
    {prev ? (
      <a class="prev" href={prev.chapter.href}>
        <span>Previous</span>
        {prev.chapter.title}
      </a>
    ) : (
      <span />
    )}
    {next && (
      <a class="next" href={next.chapter.href}>
        <span>Next</span>
        {next.chapter.title}
      </a>
    )}
  </nav>
</BookLayout>

<style>
  .book-mark {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--text-dim);
    margin-bottom: 0.9rem;
  }
  .book-mark a {
    color: var(--text-dim);
    text-decoration: none;
  }
  .book-mark a:hover {
    color: var(--accent);
  }

  /* Marks a chapter whose source file lives outside the knowledge tree — the
     always-on page and the binding constitution — so a reader knows they are
     looking at the real artifact, not a restatement of it. */
  .opening-note {
    font-family: var(--font-sans);
    font-size: 0.82rem;
    line-height: 1.6;
    color: var(--text-secondary);
    background: var(--accent-glow);
    border: 1px solid var(--accent-border);
    border-radius: var(--radius);
    padding: 0.85rem 1rem;
    margin-bottom: 2rem;
  }

  .turn {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
    margin-top: 3.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border-dim);
    font-family: var(--font-sans);
  }
  .turn a {
    font-size: 0.92rem;
    color: var(--text-secondary);
    text-decoration: none;
  }
  .turn a:hover {
    color: var(--text);
  }
  .turn span {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--text-dim);
    margin-bottom: 0.35rem;
  }
  .turn .next {
    text-align: right;
    grid-column: 2;
  }
</style>
